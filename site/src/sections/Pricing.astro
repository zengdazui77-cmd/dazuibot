---
// /pricing 页（§6.5）：价格卡、与订阅制的对照、计费口径说明。
// 白标版不列任何具体单价：pricing.snapshot.json 是上游抓来的静态快照，而本站 68 条模型里有 54 条用
// tiered_expr 的 weekday()/hour() 时段浮动计价，静态单价只在某个时段成立——写出来就是错的。
// 所以这一页只讲"怎么计费"，数字一律指向站点后台的实时定价。
// 价格表（islands/PriceTable.tsx）和计算器（islands/PriceCalculator.tsx）仍在仓库里，数据源恢复后可以接回来。
import EyesMark from "../components/EyesMark.astro";
import PriceCards from "../components/PriceCards.astro";
import { dict, fmt, buildVars, type Lang } from "../i18n";
import { MF } from "../lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const p = t.pricing;
const v = buildVars(lang);
---
<section class="section pricing" aria-labelledby="pricing-h">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{p.eyebrow}</span>
      <h1 class="h2" id="pricing-h"><mark class="hl reveal-hl">{p.h2mark}</mark>{p.h2rest}</h1>
      <p class="lead prose">{p.lead}</p>
      <p class="small muted">{p.snapshot}</p>
    </div>

    <PriceCards lang={lang} />

    <div class="pricing__block">
      <div class="table-wrap contrast reveal">
        <table class="table">
          <caption class="sr-only">{p.contrast.caption}</caption>
          <thead><tr>{p.contrast.head.map((h, i) => (i === 0 ? <td></td> : <th scope="col">{h}</th>))}</tr></thead>
          <tbody>{p.contrast.rows.map((r) => <tr><th scope="row">{r[0]}</th><td data-label={p.contrast.head[1]}>{r[1]}</td><td data-label={p.contrast.head[2]}>{r[2]}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="small muted">{p.contrast.note}</p>
    </div>

    <div class="pricing__block">
      <p class="models__cta"><a class="btn btn--primary" href={MF.pricing} target="_blank" rel="noopener" data-track="pricing_cta_click" data-track-location="pricing-live">{p.snapshotLink}</a></p>
    </div>

    <div class="pbanner">
      <EyesMark size={32} />
      <p>{p.banner.text}</p>
      <a class="btn btn--primary" href={MF.home} target="_blank" rel="noopener" data-track="mf_key_click" data-track-location="pricing">{p.banner.cta}</a>
    </div>
  </div>
</section>
