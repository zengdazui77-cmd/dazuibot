---
// 下载页。版式和首页同一套：居中的页头 + 一个主操作，下面是等宽的卡片，层次靠留白和细线。样式在 pages.css 的"下载"。
//   页头：标记 → 标题 → 一句话 → 按系统识别的下载按钮（client.ts 的 [data-dl]）→ 版本、更新日志、发布页。
//   平台：Windows、macOS、Linux 三张卡，结构相同（macOS 一张卡两颗按钮：Apple 芯片、Intel）；识别出的系统标"你的系统"。
//   其它安装方式：Docker、命令行两张卡，每张三步。首页的 Docker 入口链到 #docker。
//   校验：完整的 SHA-256 只放在这一节，不进平台卡。
import Base from "../layouts/Base.astro";
import CodeLine from "../components/CodeLine.astro";
import DownloadButton from "../components/DownloadButton.astro";
import EyesMark from "../components/EyesMark.astro";
import Icon from "../components/Icon.astro";
import { dict, fmt, href, fmtDate, type Lang } from "../i18n";
import { releases, PLATFORMS, GITHUB_URL, hasRepo } from "../lib/site";
import "../styles/pages.css";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const d = t.download;
const published = fmtDate(releases.publishedAt, lang);
// 句子里的数值单独用等宽（句子本身是无衬线），值先转义再包 span
const mono = (x: string | number) => `<span class="mono">${String(x).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!)}</span>`;

type Build = (typeof PLATFORMS)[number];
type Group = { id: "win" | "mac" | "linux"; icon: "windows" | "apple" | "linux"; builds: Build[]; tip?: string; cmd?: string };
// id 和 lib/platform.ts 的 os 同名，页面底下的脚本靠它找到识别出的那张卡
const groups: Group[] = [
  { id: "win", icon: "windows", builds: ["win-x64"], tip: d.winHint },
  { id: "mac", icon: "apple", builds: ["mac-arm64", "mac-x64"], tip: d.macHint },
  { id: "linux", icon: "linux", builds: ["linux-x64"], cmd: d.linuxHint },
];
const docker = [
  { label: d.dockerSteps.run, code: releases.platforms.docker.command, track: "docker_cmd_copy", trackCommand: "docker-run" },
  { label: d.dockerSteps.token, code: "docker exec amb cat /data/ui-token" },
  { label: d.dockerSteps.open, code: d.dockerUrl },
];
// 还没建仓库时 clone 这条没有意义，从步骤里去掉，只留安装/启动
const cli = [
  ...(hasRepo ? [{ label: d.cliSteps.clone, code: `git clone ${GITHUB_URL}.git && cd dazuibot` }] : []),
  { label: d.cliSteps.setup, code: "npm install && npm run setup" },
  { label: d.cliSteps.start, code: "npm start" },
];
const verify = [
  { label: d.platform["win-x64"], cmd: d.verifyWin },
  { label: d.verifyUnixLabel, cmd: d.verifyUnix },
];
---
<Base lang={lang} path="/download" title={`${d.pageTitle} — dazuibot`} description={d.pageDescription}>
  <div class="container page dl-page">
    <header class="dl-hero">
      <EyesMark size={72} class="dl-hero__mark" lookAt="#dl-cta" />
      <h1>{d.pageTitle}</h1>
      <p class="lead">{d.pageLead}</p>
      <DownloadButton lang={lang} placement="download-hero" plain id="dl-cta" fallback="#platforms" />
      <p class="dl-hero__meta"><span set:html={fmt(d.meta, { version: mono(releases.version), publishedAt: mono(published) })} /> · <a href={href(lang, "/changelog")}>{d.changelog}</a> · {hasRepo && <a href={`${GITHUB_URL}/releases`} target="_blank" rel="noopener">{d.releases}</a>}</p>
      {t.hero.appUiNote && <p class="small muted">{t.hero.appUiNote}</p>}
    </header>

    <ul class="dl-plats" id="platforms" role="list" data-placement="download-page">
      {groups.map((g) => (
        <li class="card dl-plat" data-dl-card={g.id}>
          <div class="dl-plat__top">
            <span class="dl-ico"><Icon name={g.icon} size={22} /></span>
            <span class="badge badge--accent" data-dl-you hidden>{d.yourSystem}</span>
          </div>
          <div>
            <h2 class="h3">{d.platform[g.builds[0]]}</h2>
            <p class="dl-plat__meta">
              {g.builds.map((p, i) => (
                <Fragment>{i > 0 && " · "}{d.arch[p]}{g.builds.length > 1 ? " " : " · "}<span class="mono">{releases.platforms[p].sizeMB} MB</span></Fragment>
              ))}
            </p>
          </div>
          <div class="dl-plat__btns">
            {g.builds.map((p) => (
              <a class="btn btn--secondary" href={releases.platforms[p].url} download data-dl-platform={p} aria-label={`${d.generic} ${d.items[p]}`}><Icon name="download" size={16} />{g.builds.length > 1 ? d.arch[p] : d.generic}</a>
            ))}
          </div>
          <div class="dl-plat__hint">
            <p class="eyebrow">{d.firstRun}</p>
            {g.cmd ? <CodeLine lang={lang} code={g.cmd} /> : <p class="dl-plat__tip">{g.tip}</p>}
          </div>
        </li>
      ))}
    </ul>
    <p class="small muted dl-note">{d.macNote}</p>

    <section class="dl-sec" aria-labelledby="ways-h">
      <h2 class="subhead" id="ways-h">{d.altTitle}</h2>
      <div class="dl-ways">
        <article class="card dl-way" id="docker">
          <span class="dl-ico"><Icon name="server" size={22} /></span>
          <h3 class="h3">{d.dockerTitle}</h3>
          <p class="dl-sub">{t.devices.items.docker.body}</p>
          <ol class="dl-steps" role="list">
            {docker.map((s) => <li><p class="dl-steps__label">{s.label}</p><CodeLine lang={lang} code={s.code} track={s.track} trackCommand={s.trackCommand} /></li>)}
          </ol>
          <p class="warnnote"><Icon name="warn" /><span>{d.warn}</span></p>
        </article>
        <article class="card dl-way" id="cli">
          <span class="dl-ico"><Icon name="terminal" size={22} /></span>
          <h3 class="h3">{d.cliTitle}</h3>
          <p class="dl-sub">{d.cliBody}</p>
          <ol class="dl-steps" role="list">
            {cli.map((s) => <li><p class="dl-steps__label">{s.label}</p><CodeLine lang={lang} code={s.code} /></li>)}
          </ol>
        </article>
      </div>
    </section>

    <section class="dl-sec dl-verify" aria-labelledby="verify-h">
      <div class="dl-verify__how">
        <h2 class="subhead" id="verify-h">{d.verifyTitle}</h2>
        <p class="dl-sub">{d.verifyLead}</p>
        <dl class="dl-verify__cmds">
          {verify.map((x) => <div><dt>{x.label}</dt><dd><CodeLine lang={lang} code={x.cmd} /></dd></div>)}
        </dl>
      </div>
      <ul class="card dl-sums" role="list" aria-label={d.sha}>
        {PLATFORMS.map((p) => (
          <li class="dl-sums__row">
            <span class="dl-sums__name">{d.platform[p]} <span class="muted">{d.arch[p]}</span></span>
            <code class="dl-sums__hash">{releases.platforms[p].sha256}</code>
            <button type="button" class="copy-btn" data-copy-text={releases.platforms[p].sha256} aria-label={`${t.ui.copy} ${d.sha}`} title={t.ui.copy}><Icon name="copy" /></button>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script>
    // 识别出的系统在它那张卡上标一下；页头的主按钮由 client.ts 换成对应的安装包
    import { detectPlatform } from "../lib/platform";
    detectPlatform().then(({ os }) => {
      document.querySelector(`[data-dl-card="${os}"] [data-dl-you]`)?.removeAttribute("hidden");
    });
  </script>
</Base>
