NODE_ENV=production
PORT=8787
HOST=0.0.0.0
# Tune these starting limits to the host and expected team workload.
TEAM_API_CPUS=1.0
TEAM_API_MEMORY_LIMIT=1g
PG_DB=dazuibot_team
PG_USER=dazuibot
# Use a URL-safe random value, for example: openssl rand -hex 24
PG_PASSWORD=replace-with-url-safe-random-value
DATABASE_URL=postgres://dazuibot:replace-with-url-safe-random-value@postgres:5432/dazuibot_team
TEAM_HOST=team.example.com
TEAM_PUBLIC_URL=https://team.example.com
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TEAM_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Independent key for encrypting model API keys stored in PostgreSQL.
TEAM_CREDENTIAL_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Operator-controlled OpenAI-compatible endpoint; team members cannot change this URL.
TEAM_MODEL_BASE_URL=https://api.zdzui.xyz/v1
# Optional comma-separated model catalog. Teams may pick the "catalog" access mode to let
# members choose from exactly these models. Leave empty to disable that mode.
TEAM_MODEL_CATALOG=
TEAM_SMTP_URL=smtps://user:password@smtp.example.com:465
TEAM_MAIL_FROM=Dazuibot Teams <noreply@example.com>
TEAM_ALLOW_DEV_CODES=false
# Optional external isolated executor control plane. Leave empty to keep approved tasks waiting.
TEAM_CODE_EXECUTOR_URL=
# In production with the Kubernetes executor, use its private service-reachable team API origin,
# e.g. http://team-api.dazuibot-team.svc:8787 (only when the .svc network is private).
TEAM_CODE_EXECUTOR_BROKER_URL=
TEAM_CODE_EXECUTOR_SECRET=replace-with-a-different-random-secret-at-least-32-characters
TEAM_CODE_EXECUTOR_POLL_MS=1000
# Leave empty until a browser-based client is enabled.
CORS_ORIGINS=
