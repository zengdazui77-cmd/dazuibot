# zdzui 助手环境变量（全部可选；环境变量优先于 <数据目录>/config.json）
# 复制为 .env 后由你的进程管理器/`docker run --env-file` 加载（程序本身不自动读取 .env）

# ── 白标线路：没有环境变量可设 ───────────────────────────────────────────────
# 站点地址烧在 src/modelflare.ts 的字面量里，**不读环境变量**，也没有开关可以改：
#   1. 桌面版客户从开始菜单启动时，进程环境里不会有任何 AMB_* 变量，程序也不读 .env 文件；
#   2. 目标地址和白名单必须来自同一份字面量。若地址读环境变量、白名单又从环境变量算，
#      白名单就成了自指的，等于没有校验——谁能改自己机器上的环境变量，谁就能把客户的
#      Key 和对话静默改道到别的服务器。
# 要换站点的域名，改 src/modelflare.ts 的 RELAY_GLOBAL / MODELFLARE_WEB 和 ui/lib/links.js 的 MF_SITE，
# 三处必须指同一个站点，然后重新打包。测试需要指向本地 mock 时用 __setRelayTestEndpoints()。

# 数据目录（SQLite、magpie 隔离配置、微信登录态）。默认 ./data；桌面版默认 <userData>/data
# AMB_DATA_DIR=./data

# 管理界面。非回环地址（如 0.0.0.0）会强制令牌访问，令牌见 <数据目录>/ui-token
# AMB_UI_HOST=127.0.0.1
# AMB_UI_PORT=3600
# AMB_UI_TOKEN=

# 内置 magpie 可执行文件（默认自动查找 build/bin 或桌面版 resources/magpie）
# AMB_MAGPIE_BIN=
# 仅开发/测试：改用外部 OpenAI 兼容端点（设置后不启动内置网关，界面视为已连接、不显示连接管理）
# AMB_MAGPIE_BASE_URL=http://127.0.0.1:8080/v1
# AMB_MAGPIE_API_KEY=
# 注意：白标版没有 AMB_MODELFLARE_BASE_URL / AMB_MODELFLARE_ISSUER，也没有 AMB_RELAY_*。
# 集成测试改用 src/modelflare.ts 的 __setRelayTestEndpoints() 在进程内注入 mock 地址；
# 账户登录已关闭（ACCOUNT_LOGIN_ENABLED=false），OIDC 相关配置一律不再生效。

# 对话
# AMB_DEFAULT_MODEL=openai/gpt-5.6-sol
# AMB_CONTEXT_MESSAGES=40
# AMB_CONTEXT_CHARS=24000

# 飞书（仅首次创建默认机器人时读取；之后在界面信息面板「渠道」里修改）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# AMB_FEISHU_THROTTLE_MS=400

# 微信 iLink 接口地址（一般不用改）
# AMB_WEIXIN_API_BASE=https://ilinkai.weixin.qq.com

# Windows：代理执行命令用的 PowerShell。没有能用的 PowerShell 7 时应用会在后台自动装一份（%LOCALAPPDATA%\AnyModelBot\pwsh）
# AMB_PWSH_AUTO_INSTALL=0          # 不自动安装（设置 → 故障排查 里仍可手动安装）
# AMB_PWSH_MIRROR=https://…/       # 下载镜像前缀（后面接 PowerShell-<版本>-win-<架构>.zip；照样核对 SHA256 和签名）
# AMB_PWSH_HOME=                   # 安装位置
# AMB_PWSH_IGNORE_SYSTEM=1         # 仅测试：不用系统里的 PowerShell（CI 用它验证内置副本）

# 语言：界面设置里选"跟随系统"时用的语言（zh-CN | en）。不设时看 LC_ALL / LANG，没有或是 C / POSIX 时用简体中文。
# 托盘菜单、服务端报错、机器人发到微信 / 飞书的系统消息都跟着应用语言；界面里可以随时切换
# AMB_LANG=zh-CN

# 日志级别 debug|info|warn|error
# AMB_LOG_LEVEL=info
