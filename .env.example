# zdzui 助手环境变量
#
# 结论先说：**没有一个 AMB_* 配置项能通过环境变量设置。**
# 站点地址、可执行文件路径、数据目录、接口选择这四类能力都在编译期字面量或 <数据目录>/config.json 里，
# 不读进程环境。程序本身也不读 .env 文件（没有 dotenv 依赖）。
#
# 原因：谁能改自己机器上的环境变量，谁就能把这些改道——地址 = 把客户的 Key 和对话送到别的服务器，
# 可执行路径 = 换掉 magpie / dsh / cua-driver / 内置 PowerShell，数据目录 = 连安装状态一起伪造。
# 白名单与目标地址还会互相自指（从同一个来源现算），等于没有校验。
#
# 要改配置：编辑 <数据目录>/config.json（桌面版是 %APPDATA%\zdzui-assistant\data\config.json 等）。
# 要换站点域名：改 src/modelflare.ts 的 RELAY_GLOBAL / RELAY_ORIGINS / MODELFLARE_WEB 与
#   ui/lib/links.js 的 MF_SITE，四处必须指同一个站点，然后重新打包。
# 测试要指向本地 mock：用 src/modelflare.ts 的 __setRelayTestEndpoints()，在进程内注入，不走环境。

# ── 仍然认环境变量的：只有日志与时序（不改任何能力） ─────────────────────────
# 日志级别 debug|info|warn|error
# AMB_LOG_LEVEL=info
# 桌面版：把日志同时打到 stdout（1/0）
# AMB_LOG_STDOUT=1
# 代理子进程的 DSH 日志级别
# AMB_DSH_LOG_LEVEL=info

# 时序与参数（排查用；填错只影响快慢，不影响去哪儿、跑什么）
# AMB_STOP_GRACE_MS=10000
# AMB_AGENT_START_WAIT_MS=90000
# AMB_AGENT_TURN_TIMEOUT_MS=1800000
# AMB_AGENT_IDLE_TIMEOUT_MS=600000
# AMB_APPROVAL_TTL_MS=600000
# AMB_MAX_BACKGROUND=4
# AMB_CONTEXT_MESSAGES=40
# AMB_CONTEXT_CHARS=24000
# AMB_DSH_INIT_TIMEOUT_MS=
# AMB_DSH_RECYCLE_SESSIONS=
# AMB_DSH_IMAGES=0
# AMB_SERVER_COMPACTION=0
# AMB_SERVER_COMPACTION_TOKENS=
# AMB_MEMORY_REVIEW_DELAY_MS=90000
# AMB_FEISHU_THROTTLE_MS=400
# AMB_AGENT_PREWARM=0

# 界面语言：界面设置里选"跟随系统"时用的语言（zh-CN | en）。不设时看 LC_ALL / LANG。
# AMB_LANG=zh-CN

# ── 只在开发/CI 里用的（不进产物） ────────────────────────────────────────────
# AMB_ELECTRON_SMOKE=<截图路径>   桌面版冒烟：只在未打包的运行里认（app.isPackaged 为 true 时不生效）
# AMB_TEST_LLM_LOG=<文件>        集成测试记录 mock 模型的请求
# AMB_CUA_CACHE=<目录>           scripts/fetch-cua-driver.mjs 的下载缓存

# 机器人/渠道凭据（飞书 App ID/Secret 等）存在数据目录的 SQLite 里，由界面或 `npm run init` 写入，
# 不放在环境变量里，也不进这个文件。
